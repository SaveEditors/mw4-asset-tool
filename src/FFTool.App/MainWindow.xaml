<Window x:Class="FFTool.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FFTool.App"
        xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
        Title="MW4 Asset Tool" Height="760" Width="1360"
        MinHeight="640" MinWidth="1024"
        Background="{StaticResource BgBaseBrush}"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="{StaticResource UiFont}"
        AllowDrop="True" DragOver="Window_DragOver" DragLeave="Window_DragLeave" Drop="Window_Drop">

    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="O" Command="{Binding ImportCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="E" Command="{Binding ExportAssetCommand}"/>
        <KeyBinding Modifiers="Ctrl+Shift" Key="E" Command="{Binding ExportPackageCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding ResetViewCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Top bar ===== -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Height="48">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="◧  MW4 Asset Tool" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="MW4 · IW10 asset extractor" Style="{StaticResource Caption}"
                           VerticalAlignment="Center" Margin="12,3,0,0"/>
                <TextBlock Grid.Column="2" Text="{Binding Summary}" Style="{StaticResource Caption}"
                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton x:Name="UpdatesChip" Margin="0,0,8,0"
                            Style="{StaticResource UpdateChip}"
                            Click="ToggleUpdatesFilter_Click"
                            IsChecked="{Binding ShowingUpdatesOnly, Mode=OneWay}"
                            Visibility="{Binding HasUpdateChanges, Converter={x:Static local:BoolToVis.Instance}}"
                            Content="{Binding UpdateChipText}"
                            ToolTip="{Binding UpdateSummary}"/>
                    <Button Content="Load names…" Margin="0,0,8,0" Style="{StaticResource GhostButton}"
                            Command="{Binding LoadNamesCommand}"
                            ToolTip="Import a hash→name list from Cordycep/Saluki or a community list (CSV/TXT/JSON)"/>
                    <Button Content="CSV (package)" Margin="0,0,8,0" Style="{StaticResource GhostButton}"
                            Command="{Binding ExportCsvCommand}"
                            ToolTip="Export the selected package's asset catalog to CSV"/>
                    <Button Content="CSV (all)" Margin="0,0,8,0" Style="{StaticResource GhostButton}"
                            Command="{Binding ExportCsvAllCommand}"
                            ToolTip="Export a full game manifest — every package's assets — to one CSV (~706k rows)"/>
                    <Button Content="Images ▾" Margin="0,0,8,0" Style="{StaticResource GhostButton}"
                            Command="{Binding ExportImagesCommand}"
                            ToolTip="Export this package's detected images as PNG + DDS"/>
                    <Button Content="All images" Margin="0,0,8,0" Style="{StaticResource GhostButton}"
                            Command="{Binding ExportImagesAllCommand}"
                            ToolTip="Export EVERY package's detected images as PNG + DDS (large)"/>
                    <Button Content="Export package…" Margin="0,0,8,0" Style="{StaticResource GhostButton}"
                            Command="{Binding ExportPackageCommand}"
                            ToolTip="Export the whole selected package's raw assets  (Ctrl+Shift+E)"/>
                    <Button Content="Export game…" Margin="0,0,8,0" Style="{StaticResource GhostButton}"
                            Command="{Binding ExportGameCommand}"
                            ToolTip="Export every package's raw assets (large)"/>
                    <Button x:Name="RecentButton" Content="Recent ▾" Margin="0,0,8,0" Style="{StaticResource GhostButton}"
                            Click="RecentFolders_Click"
                            Visibility="{Binding HasRecentFolders, Converter={x:Static local:BoolToVis.Instance}}"
                            ToolTip="Re-open a recently imported game folder"/>
                    <Button Content="Import folder…" Style="{StaticResource AccentButton}"
                            Command="{Binding ImportCommand}"
                            ToolTip="Index a game directory containing .xpak / .xsub  (Ctrl+O)"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Body ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" MinWidth="260"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="360"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="320" MinWidth="240"/>
            </Grid.ColumnDefinitions>

            <!-- Packages -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- Packages / Content toggle -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,8,10,4">
                        <ToggleButton Content="Packages" IsChecked="{Binding ShowPackages, Mode=OneWay}"
                                      Click="ShowPackages_Click" Style="{StaticResource ViewToggle}"/>
                        <ToggleButton Content="Content / Maps" IsChecked="{Binding ShowContent, Mode=OneWay}"
                                      Click="ShowContent_Click" Style="{StaticResource ViewToggle}" Margin="4,0,0,0"/>
                    </StackPanel>

                    <!-- Package quick-filter (visible in Packages view) -->
                    <Grid DockPanel.Dock="Top" Margin="10,0,10,6"
                          Visibility="{Binding ShowPackages, Converter={x:Static local:BoolToVis.Instance}}">
                        <TextBox x:Name="PackageFilterBox" Height="26" VerticalContentAlignment="Center"
                                 Text="{Binding PackageFilter, UpdateSourceTrigger=PropertyChanged, Delay=120}"
                                 Background="{StaticResource SurfaceRaisedBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                 CaretBrush="{StaticResource AccentBrush}" BorderBrush="{StaticResource BorderBrush}"
                                 BorderThickness="1" Padding="8,0" FontSize="12"
                                 ToolTip="Filter packages by name or category"/>
                        <TextBlock Text="Filter packages…" Foreground="{StaticResource TextDisabledBrush}"
                                   FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=PackageFilterBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Packages (xpak) — disabled during import/export so the open package can't be
                         disposed out from under a running extraction. -->
                    <DataGrid Style="{StaticResource DarkDataGrid}" ItemsSource="{Binding PackagesView}"
                              SelectedItem="{Binding SelectedPackage}" IsEnabled="{Binding NotBusy}"
                              Visibility="{Binding ShowPackages, Converter={x:Static local:BoolToVis.Instance}}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="●" Foreground="{Binding CategoryBrush}" FontSize="11"
                                                   VerticalAlignment="Center" Margin="2,0,0,0"
                                                   ToolTip="{Binding Content}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="Auto"/>
                            <DataGridTextColumn Header="Content" Binding="{Binding Content}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Assets" Binding="{Binding AssetsText}" Width="Auto"
                                                SortMemberPath="AssetCountValue">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                                        <Setter Property="FontSize" Value="11"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="CDN" Binding="{Binding CdnText}" Width="Auto"
                                                SortMemberPath="OffDiskValue">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#FFFBBF24"/>
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="ToolTip" Value="CDN-only stubs — streamed, not installed locally (cannot be extracted)"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Setter Property="ToolTip" Value="{Binding CountsTip}"/>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>

                    <!-- Content / Maps (from fastfile names) -->
                    <DataGrid Style="{StaticResource DarkDataGrid}" ItemsSource="{Binding Content}"
                              SelectedItem="{Binding SelectedContent}"
                              Visibility="{Binding ShowContent, Converter={x:Static local:BoolToVis.Instance}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Content / Map" Binding="{Binding Content}" Width="1.6*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*"/>
                            <DataGridTextColumn Header="Files" Binding="{Binding Files}" Width="Auto"/>
                            <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="Auto"/>
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Setter Property="ToolTip" Value="{Binding Detail}"/>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}"/>

            <!-- Assets -->
            <DockPanel Grid.Column="2">
                <!-- Find text in assets -->
                <Border DockPanel.Dock="Top" Background="{StaticResource BgSunkenBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Height="38">
                    <Grid Margin="10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔎 Find text in assets:" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1" VerticalAlignment="Center" Height="26"
                                 Text="{Binding FindText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{StaticResource SurfaceRaisedBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                 CaretBrush="{StaticResource AccentBrush}" BorderBrush="{StaticResource BorderBrush}"
                                 BorderThickness="1" Padding="8,3" FontFamily="{StaticResource MonoFont}"
                                 ToolTip="Scans every on-disk asset's decompressed bytes for this text">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding FindTextCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="2" Content="Find" Style="{StaticResource AccentButton}"
                                Command="{Binding FindTextCommand}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <Button Grid.Column="3" Content="Clear" Style="{StaticResource GhostButton}"
                                Command="{Binding ClearTextCommand}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Height="40">
                    <Grid Margin="10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="ASSETS" Style="{StaticResource PaneHeader}" Margin="2,0,10,0"
                                   VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" VerticalAlignment="Center" Height="26"
                                 Text="{Binding AssetSearch, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                                 Background="{StaticResource SurfaceRaisedBrush}"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 CaretBrush="{StaticResource AccentBrush}"
                                 BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8,3"
                                 FontFamily="{StaticResource MonoFont}"
                                 ToolTip="Filter by asset hash (hex)"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Show:" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                       Margin="0,0,4,0"/>
                            <ComboBox ItemsSource="{Binding CategoryFilters}" SelectedItem="{Binding CategoryFilter}"
                                      Width="130" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Sort:" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                       Margin="0,0,4,0"/>
                            <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SortBy}"
                                      Width="130" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ToggleButton Content="☰ Table" IsChecked="{Binding TableMode, Mode=OneWay}"
                                          Click="TableMode_Click" Style="{StaticResource ViewToggle}"/>
                            <ToggleButton Content="▦ Grid" IsChecked="{Binding GridMode, Mode=OneWay}"
                                          Click="GridMode_Click" Style="{StaticResource ViewToggle}" Margin="4,0,0,0"/>
                            <ComboBox ItemsSource="{Binding ThumbSizes}" SelectedItem="{Binding ThumbSizeName}"
                                      Width="90" VerticalAlignment="Center" Margin="6,0,0,0"
                                      ToolTip="Thumbnail size (grid view)"
                                      Visibility="{Binding GridMode, Converter={x:Static local:BoolToVis.Instance}}"/>
                            <Rectangle Width="1" Fill="{StaticResource BorderBrush}" Margin="10,6"/>
                            <TextBlock Text="Go to:" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                       Margin="0,0,4,0"/>
                            <TextBox x:Name="GoToBox" Width="120" Height="26" VerticalAlignment="Center"
                                     Background="{StaticResource SurfaceRaisedBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                     CaretBrush="{StaticResource AccentBrush}" BorderBrush="{StaticResource BorderBrush}"
                                     BorderThickness="1" Padding="8,3" FontFamily="{StaticResource MonoFont}"
                                     KeyDown="GoToBox_KeyDown"
                                     ToolTip="Jump to a global offset (0x…) in a new tab sorted by address"/>
                            <Button Content="Jump" Style="{StaticResource GhostButton}" Margin="4,0,0,0"
                                    Click="GoToAddress_Click" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid>
                <TabControl x:Name="AssetTabs" Background="{StaticResource SurfaceBrush}" BorderThickness="0"
                            Style="{StaticResource DarkTabControl}">
                  <TabItem Header="Browse" Style="{StaticResource DarkTabItem}">
                <Grid>
                    <!-- Content files view (shown when browsing Content / Maps) -->
                    <DataGrid Style="{StaticResource DarkDataGrid}" ItemsSource="{Binding ContentFiles}"
                              SelectedItem="{Binding SelectedContentFile}" Panel.ZIndex="10"
                              Visibility="{Binding ShowContent, Converter={x:Static local:BoolToVis.Instance}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Fastfile" Binding="{Binding FileName}" Width="2*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource MonoFont}"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*"/>
                            <DataGridTextColumn Header="Locale" Binding="{Binding Locale}" Width="Auto"/>
                            <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Table view -->
                    <DataGrid x:Name="MainTable" Style="{StaticResource DarkDataGrid}" ItemsSource="{Binding AssetsView}"
                              SelectedItem="{Binding SelectedAsset}"
                              Visibility="{Binding TableMode, Converter={x:Static local:BoolToVis.Instance}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Δ" Binding="{Binding ChangeTag}" Width="Auto">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="ToolTip" Value="NEW / CHG since the last game update"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="FontSize" Value="10"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNew}" Value="True">
                                                <Setter Property="Foreground" Value="#FF4ADE80"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsChanged}" Value="True">
                                                <Setter Property="Foreground" Value="#FFFBBF24"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Name / hash" Binding="{Binding DisplayName}" Width="2*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="Auto">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <!-- CDN stubs stand out amber and dimmed: not installed, not extractable. -->
                                            <DataTrigger Binding="{Binding IsOffDisk}" Value="True">
                                                <Setter Property="Foreground" Value="#FFFBBF24"/>
                                                <Setter Property="ToolTip" Value="CDN-only stub — streamed, not installed locally (cannot be extracted)"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Dims" Binding="{Binding Dims}" Width="Auto"/>
                            <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="Auto"/>
                            <DataGridTextColumn Header="Packed" Binding="{Binding Packed}" Width="Auto"/>
                            <DataGridTextColumn Header="Offset" Binding="{Binding Offset}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Thumbnail grid view -->
                    <ListBox x:Name="GridView" ItemsSource="{Binding AssetsView}"
                             SelectedItem="{Binding SelectedAsset}"
                             Background="{StaticResource SurfaceBrush}" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             Visibility="{Binding GridMode, Converter={x:Static local:BoolToVis.Instance}}">
                        <ListBox.InputBindings>
                            <KeyBinding Modifiers="Ctrl" Key="C" Command="{Binding CopyHashCommand}"/>
                        </ListBox.InputBindings>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <vwp:VirtualizingWrapPanel Orientation="Horizontal" SpacingMode="Uniform"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="4"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bd" Background="{StaticResource BgSunkenBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                    CornerRadius="4">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                    <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Loaded="Thumb_Loaded" DataContextChanged="Thumb_DataContextChanged"
                                      Width="{Binding DataContext.ThumbCellSize, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                      Height="{Binding DataContext.ThumbCellSize, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Border Background="{StaticResource BgBaseBrush}" Margin="6,6,6,2" CornerRadius="3">
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="4"
                                               RenderOptions.BitmapScalingMode="Fant"/>
                                    </Border>
                                    <TextBlock Grid.Row="1" Text="{Binding ShortHash}" HorizontalAlignment="Center"
                                               Margin="0,0,0,6" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
                  </TabItem>
                </TabControl>

                    <!-- Center empty-state: shown when no package's assets are loaded. -->
                    <Border Background="{StaticResource SurfaceBrush}" IsHitTestVisible="False"
                            Visibility="{Binding NoAssetsLoaded, Converter={x:Static local:BoolToVis.Instance}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                            <TextBlock Text="No package loaded" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" FontSize="13"
                                       Foreground="{StaticResource TextDisabledBrush}"
                                       Text="Pick a package from the left to list its assets, then switch to the Grid to browse decoded thumbnails. Use Import folder… (Ctrl+O) to point at a different game directory."/>
                        </StackPanel>
                    </Border>
                </Grid>
            </DockPanel>

            <GridSplitter Grid.Column="3" Width="1" HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}"/>

            <!-- Inspector -->
            <Border Grid.Column="4" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <StackPanel>
                    <TextBlock Text="INSPECTOR" Style="{StaticResource PaneHeader}"/>

                    <!-- Empty-state guidance when nothing is selected. -->
                    <StackPanel Margin="14,8" Visibility="{Binding NothingSelected, Converter={x:Static local:BoolToVis.Instance}}">
                        <TextBlock Text="No asset selected" Foreground="{StaticResource TextSecondaryBrush}"
                                   FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12"
                                   Foreground="{StaticResource TextDisabledBrush}"
                                   Text="Select a package on the left, then pick an asset to inspect it. Images show a live preview you can export to PNG or DDS; other assets show detected type and a hex view."/>
                        <TextBlock TextWrapping="Wrap" Margin="0,10,0,0" FontSize="12"
                                   Foreground="{StaticResource TextDisabledBrush}"
                                   Text="Amber CDN entries are streamed on demand and are not installed locally."/>
                    </StackPanel>

                    <!-- Fastfile structure (when a Content/Maps fastfile is selected) -->
                    <StackPanel Margin="12,4" Visibility="{Binding HasFastfileInfo,
                                Converter={x:Static local:BoolToVis.Instance}}">
                        <TextBlock Text="{Binding SelectedContentFile.FileName}" FontFamily="{StaticResource MonoFont}"
                                   Foreground="{StaticResource AccentBrush}" FontSize="13" TextWrapping="Wrap"/>
                        <TextBlock Text="FASTFILE STRUCTURE" Margin="0,10,0,4" FontWeight="SemiBold" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <Border Background="{StaticResource BgSunkenBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="4">
                            <TextBlock Text="{Binding FastfileInfo}" FontFamily="{StaticResource MonoFont}"
                                       FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" Padding="8"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Decompress zone" Style="{StaticResource AccentButton}"
                                    Command="{Binding DecompressZoneCommand}"/>
                            <Button Content="Export zone…" Style="{StaticResource GhostButton}"
                                    Command="{Binding ExportZoneCommand}" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="The container is Oodle-compressed (decompressable). Asset names inside are hash-referenced and resolved by the game at runtime, so the zone is the binary asset graph — not human-named files."
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <Border Margin="0,8,0,0" Background="{StaticResource BgSunkenBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                Visibility="{Binding HasZone, Converter={x:Static local:BoolToVis.Instance}}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="220">
                                <TextBlock Text="{Binding ZonePreview}" FontFamily="{StaticResource MonoFont}"
                                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                           Padding="8" TextWrapping="NoWrap"/>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>

                    <StackPanel Margin="12,4" Visibility="{Binding HasAsset,
                                Converter={x:Static local:BoolToVis.Instance}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding SelectedAsset.Hash}" FontFamily="{StaticResource MonoFont}"
                                       Foreground="{StaticResource AccentBrush}" FontSize="14" TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Copy" Style="{StaticResource GhostButton}"
                                    Command="{Binding CopyHashCommand}" Margin="8,0,0,0" Padding="8,2"
                                    VerticalAlignment="Top" ToolTip="Copy this asset's hash to the clipboard"/>
                        </Grid>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0"
                                   Text="{Binding SelectedAsset.Size, StringFormat='Decompressed: {0}'}"/>
                        <TextBlock Style="{StaticResource Caption}"
                                   Text="{Binding SelectedAsset.Packed, StringFormat='Compressed: {0}'}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Caption}" FontFamily="{StaticResource MonoFont}"
                                       VerticalAlignment="Center"
                                       Text="{Binding SelectedAsset.Offset, StringFormat='Global offset: {0}'}"/>
                            <Button Grid.Column="1" Content="Copy" Style="{StaticResource GhostButton}"
                                    Command="{Binding CopyOffsetCommand}" Margin="8,0,0,0" Padding="8,2"
                                    VerticalAlignment="Center" ToolTip="Copy this asset's global offset to the clipboard"/>
                        </Grid>
                        <TextBlock Margin="0,10,0,2" FontWeight="SemiBold" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Text="DETECTED"/>
                        <TextBlock Text="{Binding DetectedType}" Foreground="{StaticResource SuccessBrush}"
                                   TextWrapping="Wrap"/>

                        <!-- CDN stub notice: shown when the selected asset is streamed, not installed. -->
                        <Border Margin="0,10,0,0" CornerRadius="4" BorderThickness="1" Padding="10,8"
                                Background="#22FBBF24" BorderBrush="#66FBBF24"
                                Visibility="{Binding IsSelectedOffDisk, Converter={x:Static local:BoolToVis.Instance}}">
                            <StackPanel>
                                <TextBlock Text="⬦ CDN-only asset" FontWeight="SemiBold" FontSize="12"
                                           Foreground="#FFFBBF24"/>
                                <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="This asset is streamed from the CDN on demand and is not installed on disk, so there is nothing to extract. It will download into the package only when the game needs it."/>
                            </StackPanel>
                        </Border>

                        <!-- Texture preview -->
                        <StackPanel Visibility="{Binding HasCandidates,
                                    Converter={x:Static local:BoolToVis.Instance}}">
                            <TextBlock Margin="0,12,0,4" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" Text="TEXTURE PREVIEW"/>
                            <Border Background="{StaticResource BgSunkenBrush}" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="6" Height="200">
                                <Grid>
                                    <Image Source="{Binding Preview}" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="Fant"
                                           Visibility="{Binding HasPreview, Converter={x:Static local:BoolToVis.Instance}}"/>
                                    <TextBlock Text="{Binding PreviewError}" Foreground="{StaticResource ErrorBrush}"
                                               TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextAlignment="Center" FontSize="12"
                                               Visibility="{Binding HasPreview, Converter={x:Static local:BoolToVis.Inverse}}"/>
                                </Grid>
                            </Border>
                            <TextBlock Text="Auto-detected size/format — override if needed:"
                                       Style="{StaticResource Caption}" Margin="0,8,0,3"/>
                            <ComboBox ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate}"
                                      Style="{StaticResource DarkCombo}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Save PNG…" Style="{StaticResource AccentButton}"
                                        Command="{Binding ExportPngCommand}"/>
                                <Button Content="Save DDS…" Style="{StaticResource GhostButton}"
                                        Command="{Binding ExportDdsCommand}" Margin="8,0,0,0"
                                        ToolTip="Export as a valid DDS (opens in Photoshop/GIMP/Paint.NET)"/>
                                <Button Content="Copy image" Style="{StaticResource GhostButton}"
                                        Command="{Binding CopyImageCommand}" Margin="8,0,0,0"
                                        ToolTip="Copy the decoded image to the clipboard"/>
                            </StackPanel>

                            <!-- Format-detection test tool: show ALL interpretations; double-click the correct one (logged) -->
                            <CheckBox Content="Show all formats (test tool)" IsChecked="{Binding ShowAllFormats}"
                                      Margin="0,12,0,0"/>
                            <TextBlock Text="Double-click the correct render — it's logged to find dims→format patterns."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,4"
                                       Visibility="{Binding ShowAllFormats, Converter={x:Static local:BoolToVis.Instance}}"/>
                            <ItemsControl ItemsSource="{Binding CandidateThumbs}"
                                          Visibility="{Binding ShowAllFormats, Converter={x:Static local:BoolToVis.Instance}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="104" Margin="3" Background="{StaticResource BgSunkenBrush}"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                                MouseLeftButtonDown="Candidate_DoubleClick" Cursor="Hand">
                                            <StackPanel>
                                                <Image Source="{Binding Image}" Height="88" Stretch="Uniform" Margin="4"
                                                       RenderOptions.BitmapScalingMode="Fant"/>
                                                <TextBlock Text="{Binding Label}" FontSize="10" HorizontalAlignment="Center"
                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding ScoreText}" Style="{StaticResource Caption}"
                                                           HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Visibility="{Binding HasStrings, Converter={x:Static local:BoolToVis.Instance}}">
                            <TextBlock Margin="0,12,0,4" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" Text="STRINGS (text asset)"/>
                            <Border Background="{StaticResource BgSunkenBrush}" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="4">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="160">
                                    <TextBlock Text="{Binding StringsPreview}" FontFamily="{StaticResource MonoFont}"
                                               FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"
                                               Padding="8" TextWrapping="Wrap"/>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>

                        <TextBlock Margin="0,12,0,4" FontWeight="SemiBold" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Text="HEX"/>
                        <Border Background="{StaticResource BgSunkenBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="200">
                                <TextBlock Text="{Binding HexPreview}" FontFamily="{StaticResource MonoFont}"
                                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                           Padding="8" TextWrapping="NoWrap"/>
                            </ScrollViewer>
                        </Border>
                        <Button Content="Export raw…" Style="{StaticResource AccentButton}"
                                Command="{Binding ExportAssetCommand}" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                    </StackPanel>
                    <TextBlock Text="Select an asset to inspect and export." Style="{StaticResource Caption}"
                               Margin="12,4"
                               Visibility="{Binding HasAsset, Converter={x:Static local:BoolToVis.Inverse}}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== Status bar ===== -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Height="28">
            <Grid Margin="12,0">
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Style="{StaticResource Caption}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Reveal in Explorer" Style="{StaticResource GhostButton}" Margin="0,0,10,0"
                            Padding="8,2" FontSize="11" Command="{Binding RevealExportCommand}"
                            Visibility="{Binding HasLastExport, Converter={x:Static local:BoolToVis.Instance}}"
                            ToolTip="Open the last export in Explorer"/>
                    <TextBlock Text="{Binding PreloadStatus}" Style="{StaticResource Caption}"
                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"
                               Visibility="{Binding IsPreloading, Converter={x:Static local:BoolToVis.Instance}}"/>
                    <ProgressBar Width="220" Height="4" VerticalAlignment="Center"
                                 Minimum="0" Maximum="100" Value="{Binding Progress}"
                                 Background="{StaticResource SurfaceRaisedBrush}" Foreground="{StaticResource AccentBrush}"
                                 BorderThickness="0"
                                 Visibility="{Binding IsBusy, Converter={x:Static local:BoolToVis.Instance}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Drag-and-drop overlay: shown while a folder is dragged over the window. -->
        <Border x:Name="DropOverlay" Grid.RowSpan="3" Visibility="Collapsed" IsHitTestVisible="False"
                Background="#CC0B0E12">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="10"
                    BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" Padding="40,28"
                    Background="{StaticResource SurfaceRaisedBrush}">
                <StackPanel>
                    <TextBlock Text="⤓  Drop to import" FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Release to index this game folder" FontSize="13" Margin="0,6,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
